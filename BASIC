local function getLocalTeam()
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return nil end
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    local mainGameFrame = main:FindFirstChild("MainGameFrame")
    if not mainGameFrame then return nil end
    local playersFrame = mainGameFrame:FindFirstChild("PlayersFrame")
    if not playersFrame then return nil end
    
    local teamRed = playersFrame:FindFirstChild("TeamRedFrame")
    local teamBlue = playersFrame:FindFirstChild("TeamBlueFrame")
    
    if teamRed and teamRed:FindFirstChild(player.Name) then
        return "Red"
    elseif teamBlue and teamBlue:FindFirstChild(player.Name) then
        return "Blue"
    end
    return nil
end

local function refreshLocalTeam()
    localTeamCache = getLocalTeam()
    return localTeamCache
end

local function isEnemy(targetPlayer)
    if localTeamCache == nil then
        refreshLocalTeam()
    end
    
    if localTeamCache == nil then return false end
    
    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    local mainGameFrame = main:FindFirstChild("MainGameFrame")
    if not mainGameFrame then return false end
    local playersFrame = mainGameFrame:FindFirstChild("PlayersFrame")
    if not playersFrame then return false end
    
    local teamRed = playersFrame:FindFirstChild("TeamRedFrame")
    local teamBlue = playersFrame:FindFirstChild("TeamBlueFrame")
    
    local targetName = targetPlayer.Name
    
    if localTeamCache == "Red" then
        if teamBlue and teamBlue:FindFirstChild(targetName) then
            return true
        end
    elseif localTeamCache == "Blue" then
        if teamRed and teamRed:FindFirstChild(targetName) then
            return true
        end
    end
    
    return false
end

local function isEnemyVisible(targetPart)
    local character = player.Character
    if not character then return false end
    
    local originPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not originPart then return false end
    
    local direction = (targetPart.Position - originPart.Position).Unit
    local distance = (targetPart.Position - originPart.Position).Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local result = workspace:Raycast(originPart.Position, direction * distance, raycastParams)
    
    if result then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return false
end

local function getScreenCenter()
    local viewportSize = Camera.ViewportSize
    return Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
end

local function getBestTarget()
    local bestTarget = nil
    local shortestDistance = math.huge
    local center = getScreenCenter()
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and isEnemy(v) then
                local targetPart = v.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen and isEnemyVisible(targetPart) then
                    local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if distance < shortestDistance then
                        bestTarget = targetPart
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return bestTarget
end

local function getNearestVisibleEnemy()
    local nearest = nil
    local shortestDistance = math.huge
    local character = player.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 and isEnemy(v) then
                local targetRoot = v.Character.HumanoidRootPart
                local distance = (targetRoot.Position - rootPart.Position).Magnitude
                if distance < shortestDistance and isEnemyVisible(targetRoot) then
                    nearest = v
                    shortestDistance = distance
                end
            end
        end
    end
    return nearest
end

local function getCurrentWeapon()
    local character = player.Character
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child:FindFirstChild("fire") then
            return child
        end
    end
    return nil
end

local function shootAtEnemy(enemy)
    if not enemy or not enemy.Character then return false end
    local weapon = getCurrentWeapon()
    if not weapon then return false end
    
    local targetPart = enemy.Character:FindFirstChild("HumanoidRootPart") or enemy.Character:FindFirstChild("Head")
    if not targetPart then return false end
    if not isEnemyVisible(targetPart) then return false end
    
    local character = player.Character
    if not character then return false end
    
    local myPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not myPart then return false end
    
    local direction = (targetPart.Position - myPart.Position).Unit
    
    pcall(function()
        if weapon:FindFirstChild("fire") then
            weapon.fire:FireServer()
        end
        local killRemote = weapon:FindFirstChild("kill")
        if killRemote then
            killRemote:FireServer(enemy, direction, targetPart.Position)
        end
    end)
    
    return true
end

local function autoShootLoop()
    while autoShootEnabled do
        local now = tick()
        if now - autoShootLastTime >= autoShootDelay then
            local nearestEnemy = getNearestVisibleEnemy()
            if nearestEnemy then
                if shootAtEnemy(nearestEnemy) then
                    autoShootLastTime = now
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

local function enableAutoShoot()
    autoShootEnabled = true
    autoShootLastTime = 0
    task.spawn(autoShootLoop)
end

local function disableAutoShoot()
    autoShootEnabled = false
end

local function enablePerfectShoot()
    if mt then return end
    mt = getrawmetatable(game)
    oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, index)
        if index == "Hit" or index == "Target" then
            local targetPart = getBestTarget()
            if targetPart and targetPart.Parent and targetPart.Parent:FindFirstChild("Humanoid") then
                local humanoid = targetPart.Parent.Humanoid
                if humanoid.Health > 0 then
                    if index == "Hit" then
                        return targetPart.CFrame
                    else
                        return targetPart
                    end
                end
            end
        end
        return oldIndex(self, index)
    end)
    setreadonly(mt, true)
end

local function disablePerfectShoot()
    if mt then
        setreadonly(mt, false)
        mt.__index = oldIndex
        setreadonly(mt, true)
        mt = nil
    end
end

local KnifeKill = nil
pcall(function()
    KnifeKill = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("KnifeKill")
end)

local function killAll()
    if not KnifeKill then return end
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player and isEnemy(targetPlayer) then
            local character = targetPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                pcall(function()
                    KnifeKill:FireServer(targetPlayer, targetPlayer)
                end)
            end
        end
    end
end

local function updateESP()
    if not espEnabled then return end
    
    refreshLocalTeam()
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local character = otherPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local highlight = highlightObjects[otherPlayer]
                    
                    if not highlight or highlight.Parent ~= character then
                        if highlight then
                            pcall(function() highlight:Destroy() end)
                        end
                        
                        highlight = Instance.new("Highlight")
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillTransparency = 0.5
                        highlight.OutlineTransparency = 0.3
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        
                        if isEnemy(otherPlayer) then
                            highlight.FillColor = Color3.fromRGB(255, 50, 100)
                        else
                            highlight.FillColor = Color3.fromRGB(0, 255, 150)
                        end
                        
                        highlight.Parent = character
                        highlightObjects[otherPlayer] = highlight
                    end
                else
                    if highlightObjects[otherPlayer] then
                        pcall(function() highlightObjects[otherPlayer]:Destroy() end)
                        highlightObjects[otherPlayer] = nil
                    end
                end
            end
        end
    end
end

local function clearESP()
    for _, highlight in pairs(highlightObjects) do
        pcall(function() highlight:Destroy() end)
    end
    highlightObjects = {}
end

