local function createBtn(text, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 48)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(100, 70, 150)
    btn.Text = text .. "  ○ OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = menu
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(200, 100, 255)
    stroke.Thickness = 2
    stroke.Transparency = 0.3
    stroke.Parent = btn
    
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(110, 80, 160)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 70, 150))
    }
    gradient.Parent = btn
    
    local btnGlow = Instance.new("ImageLabel")
    btnGlow.Size = UDim2.new(1.05, 0, 1.05, 0)
    btnGlow.Position = UDim2.new(-0.025, 0, -0.025, 0)
    btnGlow.BackgroundTransparency = 1
    btnGlow.Image = "rbxassetid://13135718668"
    btnGlow.ImageColor3 = Color3.fromRGB(200, 100, 255)
    btnGlow.ImageTransparency = 0.7
    btnGlow.ZIndex = 0
    btnGlow.Parent = btn
    
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0.92, 0, 0, 52)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.12), {Thickness = 3, Transparency = 0}):Play()
        TweenService:Create(btnGlow, TweenInfo.new(0.12), {ImageTransparency = 0.4}):Play()
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(120, 90, 170)}):Play()
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0.9, 0, 0, 48)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.12), {Thickness = 2, Transparency = 0.3}):Play()
        TweenService:Create(btnGlow, TweenInfo.new(0.12), {ImageTransparency = 0.7}):Play()
        if not perfectShootEnabled and btn == perfectShootBtn then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(100, 70, 150)}):Play()
        elseif not autoShootEnabled and btn == autoShootBtn then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(100, 70, 150)}):Play()
        elseif not espEnabled and btn == espBtn then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(100, 70, 150)}):Play()
        elseif not aimKillEnabled and btn == aimKillBtn then
            TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(100, 70, 150)}):Play()
        end
    end)
    
    return btn, stroke
end

