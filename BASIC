        autoShootBtn.BackgroundColor3 = Color3.fromRGB(190, 90, 255)
        asStroke.Transparency = 0
    end
end

local function enablePerfectShoot()
    if mt then return end
    mt = getrawmetatable(game)
    oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, index)
        if self == Mouse and (index == "Hit" or index == "Target") then
            local target = getBestTarget()
            if target then
                return (index == "Hit" and target.CFrame or target)
            end
        end
        return oldIndex(self, index)
    end)
    setreadonly(mt, true)
end

local function disablePerfectShoot()
    if mt then
        setreadonly(mt, false)
        mt.__index = oldIndex
        setreadonly(mt, true)
        mt = nil
    end
end

