local function killAll()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= LocalPlayer and isEnemy(targetPlayer) then
            local character = targetPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 and KnifeKill then
                pcall(function()
                    KnifeKill:FireServer(targetPlayer, targetPlayer)
                end)
            end
        end
    end
end

local function removeESP(player)
    local highlight = highlightObjects[player]
    if highlight then
        pcall(function()
            highlight:Destroy()
        end)
        highlightObjects[player] = nil
    end
end

local function updateESP()
    if not espEnabled then return end
    
    refreshLocalTeam()
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= LocalPlayer then
            local character = otherPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
                local highlight = highlightObjects[otherPlayer]
                
                if not highlight or highlight.Parent ~= character then
                    if highlight then
                        pcall(function() highlight:Destroy() end)
                    end
                    
                    highlight = Instance.new("Highlight")
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0.3
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    
                    if isEnemy(otherPlayer) then
                        highlight.FillColor = Color3.fromRGB(255, 50, 100)
                    else
                        highlight.FillColor = Color3.fromRGB(0, 255, 150)
                    end
                    
                    highlight.Parent = character
                    highlightObjects[otherPlayer] = highlight
                else
                    local isEnemyState = isEnemy(otherPlayer)
                    local correctColor = isEnemyState and Color3.fromRGB(255, 50, 100) or Color3.fromRGB(0, 255, 150)
                    if highlight.FillColor ~= correctColor then
                        highlight.FillColor = correctColor
                    end
                end
            else
                if highlightObjects[otherPlayer] then
                    pcall(function() highlightObjects[otherPlayer]:Destroy() end)
                    highlightObjects[otherPlayer] = nil
                end
            end
        end
    end
end

local function clearESP()
    for _, highlight in pairs(highlightObjects) do
        pcall(function() highlight:Destroy() end)
    end
    highlightObjects = {}
end

local function toggleESP()
    espEnabled = not espEnabled
    
    if espEnabled then
        refreshLocalTeam()
        updateESP()
        espBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        espStroke.Transparency = 0
        espBtn.Text = "  CHAMS ESP  ● ON"
