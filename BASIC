local function getLocalTeam()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return nil end
    local main = playerGui:FindFirstChild("Main")
    if not main then return nil end
    local mainGameFrame = main:FindFirstChild("MainGameFrame")
    if not mainGameFrame then return nil end
    local playersFrame = mainGameFrame:FindFirstChild("PlayersFrame")
    if not playersFrame then return nil end
    
    local teamRed = playersFrame:FindFirstChild("TeamRedFrame")
    local teamBlue = playersFrame:FindFirstChild("TeamBlueFrame")
    
    if teamRed and teamRed:FindFirstChild(LocalPlayer.Name) then
        return "Red"
    elseif teamBlue and teamBlue:FindFirstChild(LocalPlayer.Name) then
        return "Blue"
    end
    return nil
end

local function refreshLocalTeam()
    localTeamCache = getLocalTeam()
    return localTeamCache
end

local function isEnemy(targetPlayer)
    if localTeamCache == nil then
        refreshLocalTeam()
    end
    
    if localTeamCache == nil then return false end
    
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end
    local main = playerGui:FindFirstChild("Main")
    if not main then return false end
    local mainGameFrame = main:FindFirstChild("MainGameFrame")
    if not mainGameFrame then return false end
    local playersFrame = mainGameFrame:FindFirstChild("PlayersFrame")
    if not playersFrame then return false end
    
    local teamRed = playersFrame:FindFirstChild("TeamRedFrame")
    local teamBlue = playersFrame:FindFirstChild("TeamBlueFrame")
    
    local targetName = targetPlayer.Name
    
    if localTeamCache == "Red" then
        if teamBlue and teamBlue:FindFirstChild(targetName) then
            return true
        end
    elseif localTeamCache == "Blue" then
        if teamRed and teamRed:FindFirstChild(targetName) then
            return true
        end
    end
    
    return false
end

local function isEnemyVisibleFromPlayer(targetPart)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local originPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not originPart then return false end
    
    local origin = originPart.Position
    local destination = targetPart.Position
    local direction = (destination - origin).Unit
    local distance = (destination - origin).Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {character}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    
    local raycastResult = workspace:Raycast(origin, direction * distance, raycastParams)
    
    if raycastResult then
        local hitPart = raycastResult.Instance
        if hitPart:IsDescendantOf(targetPart.Parent) then
            return true
        end
    end
    return false
end

local function getScreenCenter()
    local viewportSize = workspace.CurrentCamera.ViewportSize
    return Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
end

local function getBestTargetPerfect()
    local target = nil
    local shortestDistance = math.huge
    local center = getScreenCenter()
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if isEnemy(v) then
                local targetPart = v.Character.HumanoidRootPart
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                
                if onScreen and isEnemyVisibleFromPlayer(targetPart) then
                    local distance = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if distance < shortestDistance then
                        target = targetPart
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return target
end

local function getNearestVisibleEnemy()
    local nearest = nil
    local shortestDistance = math.huge
    local character = LocalPlayer.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            if isEnemy(v) then
                local targetRoot = v.Character.HumanoidRootPart
                local distance = (targetRoot.Position - rootPart.Position).Magnitude
                if distance < shortestDistance and isEnemyVisibleFromPlayer(targetRoot) then
                    nearest = v
                    shortestDistance = distance
                end
            end
        end
    end
    return nearest
end

local function getCurrentWeapon()
    local character = LocalPlayer.Character
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child:FindFirstChild("fire") then
            return child
        end
    end
    return nil
end

local function shootAtEnemy(enemy)
    if not enemy or not enemy.Character then return false end
    local weapon = getCurrentWeapon()
    if not weapon then return false end
    
    local targetPart = enemy.Character:FindFirstChild("HumanoidRootPart") or enemy.Character:FindFirstChild("Head")
    if not targetPart then return false end
    
    if not isEnemyVisibleFromPlayer(targetPart) then return false end
    
    local character = LocalPlayer.Character
    if not character then return false end
    
    local myPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not myPart then return false end
    
    local direction = (targetPart.Position - myPart.Position).Unit
    
    pcall(function()
        if weapon:FindFirstChild("fire") then
            weapon.fire:FireServer()
        end
        local killRemote = weapon:FindFirstChild("kill")
        if killRemote then
            killRemote:FireServer(enemy, direction, targetPart.Position)
        end
    end)
    
    return true
end

local function autoShootLoop()
    while autoShootEnabled do
        local now = tick()
        if now - autoShootLastTime >= autoShootDelay then
            local nearestEnemy = getNearestVisibleEnemy()
            if nearestEnemy then
                if shootAtEnemy(nearestEnemy) then
                    autoShootLastTime = now
                end
            end
        end
        RunService.Heartbeat:Wait()
    end
end

local function enableAutoShoot()
    autoShootEnabled = true
    autoShootLastTime = 0
    task.spawn(autoShootLoop)
end

local function disableAutoShoot()
    autoShootEnabled = false
end

local function toggleAutoShoot()
    if autoShootEnabled then
        disableAutoShoot()
        autoShootBtn.BackgroundColor3 = Color3.fromRGB(100, 70, 150)
