    else
        clearESP()
        espBtn.BackgroundColor3 = Color3.fromRGB(100, 70, 150)
        espStroke.Transparency = 0.3
        espBtn.Text = "  CHAMS ESP  ○ OFF"
        TweenService:Create(espBtn, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(100, 70, 150)}):Play()
    end
end

