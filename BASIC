end

local function enablePerfectShoot()
    if mt then return end
    mt = getrawmetatable(game)
    oldIndex = mt.__index
    setreadonly(mt, false)
    mt.__index = newcclosure(function(self, index)
        if (index == "Hit" or index == "Target") then
            local targetPart = getBestTargetPerfect()
            if targetPart and targetPart.Parent and targetPart.Parent:FindFirstChild("Humanoid") and targetPart.Parent.Humanoid.Health > 0 then
                if index == "Hit" then
                    return targetPart.CFrame
                else
                    return targetPart
                end
            end
        end
        return oldIndex(self, index)
    end)
    setreadonly(mt, true)
end

local function disablePerfectShoot()
    if mt then
        setreadonly(mt, false)
        mt.__index = oldIndex
        setreadonly(mt, true)
        mt = nil
    end
end

