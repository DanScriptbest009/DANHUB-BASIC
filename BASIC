    local highlight = highlightObjects[p]
    if highlight then
        pcall(function() highlight:Destroy() end)
        highlightObjects[p] = nil
    end
    if hitboxEnabled then
        restoreOriginalHitbox(p)
        for i, v in pairs(affectedPlayers) do
            if v == p then
                table.remove(affectedPlayers, i)
                break
            end
        end
    end
end)

